# Relative to packages/prisma/src
DATABASE_URL="file:../../../dev.db"
ADMIN_PASSWORD=opentrader
# Logging level for ccxt
# Accepts: "true" | ""
CCXT_VERBOSE=
# Custom HOST. Default is localhost
HOST=
# Custom port. Default is 4000
PORT=
# Path to custom strategies dir. Should be a full path.
CUSTOM_STRATEGIES_PATH=
# Telegram notifications (optional)
# Create a bot via @BotFather and get the token
TELEGRAM_BOT_TOKEN=
# Chat ID — send /start to your bot, then use https://api.telegram.org/bot<TOKEN>/getUpdates to find it
TELEGRAM_CHAT_ID=
########## SHARED END ######
